# Copy to .env and adjust. Never commit .env.

# --- Database ---------------------------------------------------------------
# Ports are 5440/5441: this machine already has a Postgres occupying 5432-5434,
# so the project's containers are mapped clear of it.
DATABASE_URL="postgresql://portfolio_ops:portfolio_ops_dev@localhost:5440/portfolio_ops?schema=public"
TEST_DATABASE_URL="postgresql://portfolio_ops:portfolio_ops_dev@localhost:5441/portfolio_ops_test?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-generated-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Seed (first Super Admin, spec §83) -------------------------------------
# Used only by `npm run db:seed`. Change the password before any real use.
SEED_SUPER_ADMIN_EMAIL="admin@portfolioops.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!2026"
SEED_SUPER_ADMIN_NAME="Ops Admin"

# --- Feature flags ----------------------------------------------------------
# §88 item 10: employees seeing their own computed pay. Off until policy is set.
FEATURE_MY_PAY_ENABLED=false

# --- Time policy (§ plan: stale timers) -------------------------------------
# Timers longer than this are recorded truthfully but flagged NEEDS_REVIEW.
TIMER_REVIEW_THRESHOLD_HOURS=12
# Nightly job force-stops timers older than this.
TIMER_AUTO_STOP_HOURS=24
